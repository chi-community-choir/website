# Site URL used for metadata (OpenGraph, Twitter cards, canonical URLs).
# When unset, defaults to https://chicommunitychoir.com (production URL).
# Set this to http://localhost:3000 for local development to avoid
# metadata pointing to the live site.
NEXT_PUBLIC_SITE_URL=https://chicommunitychoir.com

# Vercel Blob Storage — READ-ONLY public URL for images and audio.
# The base URL (flhaurczyt40eicf.public.blob.vercel-storage.com) is
# hardcoded in component files and CSP headers (next.config.ts).
# No write token needed for local development (uploads use Vercel dashboard).
#
# To use a different blob store, update the base URL in:
#   app/page.tsx, app/about/page.tsx, app/find-us/page.tsx,
#   next.config.ts (CSP headers)

